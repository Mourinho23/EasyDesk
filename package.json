{
  "name": "easydesk",
  "version": "1.0.2",
  "description": "Painel local para monitorizar o hardware e o sistema.",
  "main": "desktop.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "predist:win": "dotnet publish sensor-service\\EasyDesk.SensorService.csproj --configuration Release --output sensor-service\\publish && node scripts\\prepare-node-installer.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "macos-temperature-sensor": "^2.1.1",
    "osx-temperature-sensor": "^1.0.8"
  },
  "build": {
    "appId": "com.easydesk.app",
    "productName": "EasyDesk",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop.js",
      "server.js",
      "sensor-data.js",
      "Interface/**/*"
    ],
    "asarUnpack": [
      "node_modules/macos-temperature-sensor/**",
      "node_modules/osx-temperature-sensor/**"
    ],
    "win": {
      "icon": "assets/branding/easydesk.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "sensor-service/publish",
          "to": "sensor-service",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/node-installer",
          "to": "node-installer",
          "filter": [
            "Node.js-Setup-x64.msi"
          ]
        }
      ],
      "artifactName": "EasyDesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerHeader": "assets/branding/installer-header.bmp",
      "installerIcon": "assets/branding/easydesk.ico",
      "installerSidebar": "assets/branding/installer-sidebar.bmp",
      "uninstallerIcon": "assets/branding/easydesk.ico",
      "uninstallerSidebar": "assets/branding/installer-sidebar.bmp",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "EasyDesk-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EasyDesk-${version}-${arch}.${ext}",
      "category": "System"
    }
  }
}
